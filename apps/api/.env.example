NODE_ENV=development
PORT=4000
BETTER_AUTH_URL=http://localhost:4000
PLATFORM_ORIGIN=http://localhost:8001
DATABASE_URL=postgresql://user:password@localhost:5432/monorepo
REDIS_URL=redis://:password@localhost:6379
# Random value of at least 32 characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-or-more-chars
# Optional: shares the session cookie with sibling subdomains, e.g. .inzynier.pro.
# COOKIES_DOMAIN=.inzynier.pro
# Resend API key used to send sign-in codes.
RESEND_API_KEY=
