NODE_ENV=development
PORT=4000
# One of All, Trace, Debug, Info, Warn, Error, Fatal, None. Defaults to Info.
LOG_LEVEL=Info
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated client origins allowed by CORS and Better Auth.
TRUSTED_ORIGINS=http://localhost:8001
DATABASE_URL=postgresql://user:password@localhost:5432/monorepo
REDIS_URL=redis://:password@localhost:6379
# Random value of at least 32 characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-or-more-chars
# Optional Google OAuth Web client; set both values to enable Google sign-in.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: shares the session cookie with sibling subdomains, e.g. .inzynier.pro.
# COOKIES_DOMAIN=.inzynier.pro
# Header with the client address set by the proxy; set only when the origin accepts traffic from it alone.
# Without it, API rate limits use the socket address and the Better Auth sign-in limit shares one
# bucket for everyone. Production behind Cloudflare: cf-connecting-ip.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# Resend API key used to send sign-in codes.
RESEND_API_KEY=
# Optional OTLP export of traces and logs (ADR-0022). Without an endpoint, telemetry stays local.
# Local Grafana (traces, logs, dashboards on http://localhost:3000): `pnpm --filter @inzpro/api services:telemetry:up`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Grafana Cloud: OTLP endpoint and `Authorization=Basic <base64 instanceId:token>` from the stack's OTLP page.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20your-base64-credentials
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_SERVICE_VERSION=local
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# RELEASE_SHA is baked into the Docker image by CI; do not override it in Dokploy.
# Local runs default to development. The health response exposes it as x-release-sha.
