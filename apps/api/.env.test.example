NODE_ENV=test
PORT=4000
# One of All, Trace, Debug, Info, Warn, Error, Fatal, None. Defaults to Info.
LOG_LEVEL=Info
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated client origins allowed by CORS and Better Auth.
TRUSTED_ORIGINS=http://localhost:8001
DATABASE_URL=postgresql://inzpro_test:inzpro_test@127.0.0.1:55432/inzpro_test
REDIS_URL=redis://:password@localhost:56379
BETTER_AUTH_SECRET=test-secret-that-is-at-least-thirty-two-characters
# Tests deliver mail in memory; the key is never used.
RESEND_API_KEY=re_test_unused
# Google configuration tests inject test-only credentials; no provider requests are made.
# No Google project or real credentials are used by the test suite.
