{
  "name": "@inzpro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "type-check": "effect-tsgo tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "migrate:test": "turbo build --filter=@inzpro/api^... && NODE_ENV=test tsx src/lib/migrate.ts",
    "migrate:latest": "turbo build --filter=@inzpro/api^... && tsx src/lib/migrate.ts",
    "services:up": "docker compose --env-file .env -p inzpro-dev -f ../../docker-compose.local.yml up -d --wait",
    "services:down": "docker compose --env-file .env -p inzpro-dev -f ../../docker-compose.local.yml down",
    "services:test:up": "docker compose --env-file .env.test -p inzpro-test -f ../../docker-compose.test.yml up -d --wait",
    "services:test:down": "docker compose --env-file .env.test -p inzpro-test -f ../../docker-compose.test.yml down"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@inzpro/api-contracts": "workspace:*",
    "@inzpro/db": "workspace:*",
    "dotenv": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@inzpro/api-client": "workspace:*"
  }
}
