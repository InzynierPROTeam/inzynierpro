{
  "name": "@inzpro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "type-check": "effect-tsgo tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "migrate:test": "turbo build --filter=@inzpro/api^... && NODE_ENV=test tsx src/lib/migrate.ts",
    "migrate:latest": "turbo build --filter=@inzpro/api^... && tsx src/lib/migrate.ts",
    "services:up": "docker compose --env-file .env -p inzpro-dev -f ../../docker-compose.local.yml up -d --wait",
    "services:down": "docker compose --env-file .env -p inzpro-dev -f ../../docker-compose.local.yml --profile telemetry down",
    "services:telemetry:up": "docker compose --env-file .env -p inzpro-dev -f ../../docker-compose.local.yml --profile telemetry up -d otel-lgtm",
    "services:test:up": "docker compose --env-file .env.test -p inzpro-test -f ../../docker-compose.test.yml up -d --wait --force-recreate",
    "services:test:down": "docker compose --env-file .env.test -p inzpro-test -f ../../docker-compose.test.yml down --volumes --remove-orphans",
    "seed:technical": "turbo build --filter=@inzpro/api^... && tsx src/seed/main.ts",
    "seed:technical:test": "turbo build --filter=@inzpro/api^... && NODE_ENV=test tsx src/seed/main.ts",
    "e2e:serve": "turbo build --filter=@inzpro/api^... && NODE_ENV=test tsx src/test/e2e-server.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@inzpro/api-contracts": "workspace:*",
    "@inzpro/auth": "workspace:*",
    "@inzpro/config": "workspace:*",
    "@inzpro/db": "workspace:*",
    "@inzpro/domain": "workspace:*",
    "@inzpro/email": "workspace:*",
    "@inzpro/redis": "workspace:*",
    "dotenv": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@inzpro/auth-client": "workspace:*",
    "@inzpro/testing": "workspace:*",
    "@opencoredev/email-sdk": "catalog:",
    "@vercel/nft": "catalog:",
    "redis": "catalog:"
  }
}
