{
  "extends": "@total-typescript/tsconfig/bundler/no-dom",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "~e2e/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "refactors": true,
        "quickinfo": true,
        "completions": true,
        "noExternal": true,
        "ignoreEffectWarningsInTscExitCode": true
      }
    ]
  },
  "include": ["src/**/*.ts", "playwright.config.ts"]
}
