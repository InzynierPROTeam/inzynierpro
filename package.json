{
  "name": "inzpro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "type-check": "pnpm type-check:infra && turbo type-check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "effect-tsgo oxlint --type-aware",
    "lint:fix": "effect-tsgo oxlint --type-aware --fix",
    "check": "pnpm lint:fix && pnpm format && pnpm type-check && pnpm test && pnpm build",
    "test": "pnpm test:infra && scripts/with-test-services.sh turbo test",
    "test:coverage": "pnpm test:infra && scripts/with-test-services.sh turbo test -- --coverage.enabled --coverage.include=src/** --coverage.reporter=json-summary --coverage.reporter=text-summary",
    "test:e2e": "scripts/with-test-services.sh pnpm --filter @inzpro/e2e test:e2e",
    "prepare": "effect-tsgo patch --oxlint && (test -n \"$CI\" || test \"$HUSKY\" = \"0\" || husky)",
    "check:ci": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:coverage && pnpm build",
    "cloudflare": "tsx infra/cloudflare/cli.ts",
    "test:infra": "vitest run --config infra/cloudflare/vitest.config.ts",
    "type-check:infra": "effect-tsgo tsc -p infra/cloudflare/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@total-typescript/tsconfig": "catalog:",
    "@types/js-cookie": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "alchemy": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-icons-spritesheet": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "effect-tsgo oxlint --type-aware --fix --quiet",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
