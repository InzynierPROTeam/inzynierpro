{
  "extends": "@total-typescript/tsconfig/tsc/no-dom/library-monorepo",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "outDir": "dist",
    "rootDir": "src",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "refactors": true,
        "quickinfo": true,
        "completions": true,
        "noExternal": true,
        "ignoreEffectWarningsInTscExitCode": true
      }
    ],
    "paths": {
      "~redis/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
