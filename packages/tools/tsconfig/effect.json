{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "refactors": true,
        "quickinfo": true,
        "completions": true,
        "noExternal": true,
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": { "unstableApiUsage": "off" }
      }
    ]
  }
}
