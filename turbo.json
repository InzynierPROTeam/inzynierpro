{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env*",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "packages/tools/tsconfig/*.json"
  ],
  "envMode": "loose",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "inputs": [".env*"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", ".env*"],
      "outputs": ["dist/**", "*.tsbuildinfo", ".next/**", "build/**", ".output/**", ".vinxi/**"],
      "cache": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    },
    "format": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "lint:fix": {
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "@inzpro/tools#test": {
      // lint-integration.test.ts writes probe files into these packages' sources; building them
      // concurrently would compile the probes.
      "dependsOn": [
        "^build",
        "@inzpro/api-client#build",
        "@inzpro/api-contracts#build",
        "@inzpro/domain#build"
      ],
      "cache": true,
      // The architecture policy test compares the policy with the API module folders.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/modules/**"],
      "outputs": ["coverage/**"]
    },
    "@inzpro/api#test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "@inzpro/db#test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["coverage/**"]
    }
  }
}
